# Copy this file to .env. Fill in the secrets before first start.
DB_ROOT_PASSWORD=
DB_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Roster Admin"
ADMIN_PASSWORD=
APP_SECRET=

# Local Docker Compose defaults.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
ROSTER_TIMEZONE=Asia/Kuala_Lumpur

# Comma-separated HTTPS origins for webhook destinations.
# Example: WEBHOOK_ALLOWED_ORIGINS=https://n8n.example.com
WEBHOOK_ALLOWED_ORIGINS=
